{
  "name": "sprouts-workspace",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "node scripts/install-hooks.mjs",
    "release:version": "node scripts/set-release-version.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "publish:workspace": "node scripts/publish-workspace.mjs"
  },
  "devDependencies": {
    "@angular/core": "^19.2.25",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/language-core": "^3.3.14",
    "eslint": "^9.0.0",
    "react": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.0"
  }
}
