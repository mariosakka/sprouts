{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "sprouts",
      "extra-files": [
        { "type": "json", "path": "packages/core/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/vue/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/react/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/angular/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/renderer/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
